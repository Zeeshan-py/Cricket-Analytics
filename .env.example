# Public Supabase settings used by server-rendered public reads.
# These values are safe to expose only when they are publishable/anon keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only import/admin key. Never expose this through NEXT_PUBLIC_* or client components.
SUPABASE_SERVICE_ROLE_KEY=

# External raw Cricsheet JSON directory. Keep the full 3.5 GB dataset outside Git.
# Example on Windows:
# CRICSHEET_DATA_DIR=C:\Users\zeesh\Downloads\all_json
CRICSHEET_DATA_DIR=
